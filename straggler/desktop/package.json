{
  "name": "straggler-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:native": "npm run build && cargo build --locked --manifest-path src-tauri/Cargo.toml --features custom-protocol,native-tests && node tests/native-smoke.mjs",
    "test:runtime": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features",
    "format": "prettier --write src tests/*.{ts,mjs} tests/e2e *.ts *.json eslint.config.js",
    "format:check": "prettier --check src tests/*.{ts,mjs} tests/e2e *.ts *.json eslint.config.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-blockquote": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-document": "3.34.0",
    "@tiptap/extension-hard-break": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-strike": "3.34.0",
    "@tiptap/extension-text": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree@8.72.2": {
      "minimatch": "11.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
