{
  "name": "mir-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:native": "npm run build && cargo build --locked --manifest-path src-tauri/Cargo.toml --features custom-protocol,native-tests && node tests/native-smoke.mjs",
    "test:runtime": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features",
    "format": "prettier --write src tests/*.{ts,mjs} tests/e2e *.ts *.json eslint.config.js",
    "format:check": "prettier --check src tests/*.{ts,mjs} tests/e2e *.ts *.json eslint.config.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
